               <children>
                  <ImageView fitHeight="150.0" fitWidth="213.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@icons/Red_Black_Typography_Nine_Brand_Logo-removebg-preview.png" />
                     </image>
                     <VBox.margin>
                        <Insets left="35.0" />
                     </VBox.margin>
                  </ImageView>
                  <Label fx:id="usernameLabel" alignment="CENTER" prefHeight="55.0" prefWidth="214.0" text="USER NAME">
