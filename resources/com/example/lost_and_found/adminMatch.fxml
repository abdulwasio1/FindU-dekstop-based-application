                     </graphic>
                     <font>
                        <Font name="Verdana" size="14.0" />
                     </font>
                     <padding>
                        <Insets left="50.0" />
                     </padding>
                  </Button>
                  <Button fx:id="manageMatches" alignment="BASELINE_LEFT" graphicTextGap="22.0" layoutX="10.0" layoutY="229.0" mnemonicParsing="false" onAction="#clickManageMatches" prefHeight="40.0" prefWidth="217.0" style="-fx-background-color: transparent;" text="Matches" textFill="#3434ff">
                     <graphic>
                        <ImageView fitHeight="22.0" fitWidth="22.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@icons/output-onlinepngtools%20(13).png" />
                           </image>
                        </ImageView>
                     </graphic>
                     <font>
                        <Font name="Verdana" size="14.0" />
                     </font>
                     <padding>
                        <Insets left="50.0" />
                     </padding>
                  </Button>
                  <Button fx:id="profile" alignment="BASELINE_LEFT" graphicTextGap="22.0" layoutX="10.0" layoutY="259.0" mnemonicParsing="false" onAction="#clickProfile" prefHeight="40.0" prefWidth="216.0" style="-fx-background-color: transparent;" text="Profile" textFill="#3434ff">
