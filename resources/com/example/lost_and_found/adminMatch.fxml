                        <Font name="Yu Gothic UI Semibold" size="17.0" />
                     </font>
                  </Label>
                  <Button fx:id="home" alignment="BASELINE_LEFT" graphicTextGap="22.0" mnemonicParsing="false" onAction="#clickHome" prefHeight="40.0" prefWidth="215.0" style="-fx-background-color: white;" text="Home" textFill="#3434ff">
